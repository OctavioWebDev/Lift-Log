# Base URL of the Chi-Rho Lifts API server (see ../server).
# Use your machine's LAN IP (not localhost) when testing on a physical device,
# e.g. http://192.168.1.23:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# RevenueCat public API key for the iOS app (Project Settings > API Keys in
# the RevenueCat dashboard — the "Apple" public key, safe to embed client-side).
# Requires a RevenueCat project connected to App Store Connect with a
# "lifetime" (non-consumable) package configured. Leave unset and the
# Subscribe button on iOS will show "In-app purchases aren't configured yet."
# instead of crashing.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
