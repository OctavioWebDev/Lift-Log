<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Date Selector -->
  <div class="bg-white rounded-lg shadow p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">Workout Log</h2>
    
    <div class="flex items-center space-x-4">
      <label for="workout-date" class="text-sm font-medium text-gray-700">Date:</label>
      <input 
        type="date" 
        id="workout-date" 
        name="date"
        value="<%= date %>"
        class="border rounded-lg px-4 py-2"
        hx-get="/"
        hx-trigger="change"
        hx-target="body"
        hx-push-url="true"
      >
    </div>
  </div>

  <!-- Add Workout Form -->
  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Log New Set</h3>
    
    <form 
      hx-post="/api/workout-sets"
      hx-target="#workout-list"
      hx-swap="afterbegin"
      hx-on::after-request="this.reset()"
      class="space-y-4"
    >
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Exercise</label>
          <input 
            type="text" 
            name="exercise" 
            required
            placeholder="Squat"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
          >
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Sets</label>
          <input 
            type="number" 
            name="sets" 
            value="3"
            min="1"
            required
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
          >
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Weight (lbs)</label>
          <input 
            type="number" 
            name="weight" 
            required
            placeholder="225"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
          >
        </div>
        
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Reps</label>
          <input 
            type="number" 
            name="reps" 
            required
            min="1"
            placeholder="5"
            class="w-full border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
          >
        </div>
      </div>
      
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">RPE (Optional)</label>
        <input 
          type="number" 
          name="rpe" 
          step="0.5"
          min="1"
          max="10"
          placeholder="8.5"
          class="w-full md:w-32 border rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-500"
        >
      </div>
      
      <button 
        type="submit"
        class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition"
      >
        Log Set
      </button>
    </form>
  </div>

  <!-- Workout List -->
  <div class="bg-white rounded-lg shadow p-6">
    <h3 class="text-lg font-semibold text-gray-900 mb-4">Today's Workouts</h3>
    
    <div id="workout-list" class="space-y-3">
      <% if (workouts.length === 0) { %>
        <p class="text-gray-500 text-center py-8">No workouts logged for this date.</p>
      <% } else { %>
        <% workouts.forEach(function(workout) { %>
          <%- include('partials/workout-item', { workout: workout }) %>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>