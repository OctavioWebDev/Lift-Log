<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h1 class="text-3xl font-bold text-brand-900 mb-1">Training Goals</h1>
    <p class="text-brand-600">Set targets and track your progress</p>
  </div>

  <!-- Add Goal Form -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-4">Add New Goal</h2>
    <p class="text-xs text-brand-500 mb-4">
      Current updates automatically to your best logged set for this exercise as you add workouts.
    </p>

    <form
      hx-post="/api/goals"
      hx-target="#goals-list"
      hx-swap="beforeend"
      hx-on::after-request="this.reset()"
      class="space-y-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
        <div class="relative md:col-span-1">
          <label class="block text-sm font-medium text-brand-700 mb-1">Exercise</label>
          <input type="text" id="goal-exercise-search" placeholder="Search exercises..."
            autocomplete="off" required
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent">
          <input type="hidden" name="exercise" id="goal-exercise-value" required>
          <div id="goal-exercise-dropdown"
            class="hidden absolute z-20 w-full bg-gray-900 border border-gray-800 rounded-lg shadow-lg mt-1 max-h-64 overflow-y-auto">
            <% Object.entries(exerciseGroups).forEach(function([group, list]) { %>
              <div class="exercise-group-header px-3 py-1.5 text-xs font-bold text-brand-500 uppercase tracking-wide bg-black"><%= group %></div>
              <% list.forEach(function(ex) { %>
                <div class="goal-exercise-option px-3 py-2 cursor-pointer hover:bg-gray-800 text-sm text-brand-900" data-value="<%= ex %>"><%= ex %></div>
              <% }); %>
            <% }); %>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Current (lbs)</label>
          <input
            type="number"
            name="current"
            required
            placeholder="225"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
          >
        </div>

        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Target (lbs)</label>
          <input
            type="number"
            name="target"
            required
            placeholder="315"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
          >
        </div>

        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Target Date</label>
          <input
            type="date"
            name="targetDate"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent"
          >
        </div>

        <div class="flex items-end">
          <button
            type="submit"
            class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-semibold py-2 rounded-lg transition"
          >
            Add Goal
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Goals List -->
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-6 py-4 border-b border-gray-800">
      <h2 class="text-xl font-bold text-brand-900">Your Goals</h2>
    </div>

    <div id="goals-list" class="divide-y divide-gray-800">
      <% if (goals.length === 0) { %>
        <div class="px-6 py-12 text-center">
          <p class="text-brand-600">No goals set yet. Add your first goal above.</p>
        </div>
      <% } else { %>
        <% goals.forEach(function(goal) { %>
          <%- include('partials/goal-item', { goal: goal }) %>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- Edit Goal Modal -->
<div id="edit-goal-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
  <div class="bg-gray-900 rounded-lg p-6 w-full max-w-md">
    <h3 class="text-xl font-bold text-brand-900 mb-1">Edit Goal</h3>
    <p class="text-sm text-brand-600 mb-4" id="edit-goal-exercise-display"></p>

    <form id="edit-goal-form" class="space-y-4">
      <input type="hidden" id="edit-goal-exercise">

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Current (lbs)</label>
          <input type="number" id="edit-goal-current" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Target (lbs)</label>
          <input type="number" id="edit-goal-target" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-brand-700 mb-1">Target Date</label>
        <input type="date" id="edit-goal-target-date" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2">
      </div>

      <p class="text-xs text-brand-500">
        Current auto-updates from your logged workouts once you log a set for this exercise — editing it here only matters until then.
      </p>

      <div class="flex gap-3 pt-2">
        <button type="submit" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-black py-2.5 rounded-lg transition font-medium">
          Save
        </button>
        <button type="button" onclick="closeEditGoalModal()" class="flex-1 bg-gray-800 hover:bg-gray-700 text-brand-900 py-2.5 rounded-lg transition font-medium">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  setupExerciseSearch('goal-exercise-search', 'goal-exercise-value', 'goal-exercise-dropdown', 'goal-exercise-option');

  function editGoal(exercise, current, target, targetDate) {
    document.getElementById('edit-goal-exercise').value = exercise;
    document.getElementById('edit-goal-exercise-display').textContent = exercise;
    document.getElementById('edit-goal-current').value = current;
    document.getElementById('edit-goal-target').value = target;
    document.getElementById('edit-goal-target-date').value = targetDate || '';
    document.getElementById('edit-goal-modal').classList.remove('hidden');
  }

  function closeEditGoalModal() {
    document.getElementById('edit-goal-modal').classList.add('hidden');
  }

  document.getElementById('edit-goal-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const exercise = document.getElementById('edit-goal-exercise').value;
    const data = {
      current: parseFloat(document.getElementById('edit-goal-current').value),
      target: parseFloat(document.getElementById('edit-goal-target').value),
      targetDate: document.getElementById('edit-goal-target-date').value || null,
    };

    try {
      const response = await fetch(`/api/goals/${encodeURIComponent(exercise)}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      if (response.ok) {
        closeEditGoalModal();
        window.location.reload();
      } else {
        alert('Error updating goal');
      }
    } catch (error) {
      alert('Error updating goal');
    }
  });

  document.getElementById('edit-goal-modal').addEventListener('click', function (e) {
    if (e.target === this) closeEditGoalModal();
  });
</script>

<%- include('partials/footer') %>
