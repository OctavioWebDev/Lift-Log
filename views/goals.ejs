<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h1 class="text-3xl font-bold text-brand-900 mb-1">Training Goals</h1>
    <p class="text-brand-600">Set targets and track your progress</p>
  </div>

  <!-- Add Goal Form -->
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-4">Add New Goal</h2>
    
    <form 
      hx-post="/api/goals"
      hx-target="#goals-list"
      hx-swap="beforeend"
      hx-on::after-request="this.reset()"
      class="space-y-4"
    >
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Exercise</label>
          <input 
            type="text" 
            name="exercise" 
            required
            placeholder="Squat"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-brand-900 placeholder-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          >
        </div>
        
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Current (lbs)</label>
          <input 
            type="number" 
            name="current" 
            required
            placeholder="225"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-brand-900 placeholder-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          >
        </div>
        
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Target (lbs)</label>
          <input 
            type="number" 
            name="target" 
            required
            placeholder="315"
            class="w-full border border-gray-300 rounded-lg px-3 py-2 text-brand-900 placeholder-brand-400 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
          >
        </div>
        
        <div class="flex items-end">
          <button 
            type="submit"
            class="w-full bg-brand-900 hover:bg-brand-800 text-white font-semibold py-2 rounded-lg transition"
          >
            Add Goal
          </button>
        </div>
      </div>
    </form>
  </div>

  <!-- Goals List -->
  <div class="bg-white rounded-lg border border-gray-200">
    <div class="px-6 py-4 border-b border-gray-200">
      <h2 class="text-xl font-bold text-brand-900">Your Goals</h2>
    </div>
    
    <div id="goals-list" class="divide-y divide-gray-200">
      <% if (goals.length === 0) { %>
        <div class="px-6 py-12 text-center">
          <p class="text-brand-600">No goals set yet. Add your first goal above.</p>
        </div>
      <% } else { %>
        <% goals.forEach(function(goal) { %>
          <%- include('partials/goal-item', { goal: goal }) %>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
