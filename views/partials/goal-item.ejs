<div class="px-6 py-4" id="goal-<%= goal.id %>">
  <div class="flex items-start justify-between mb-3">
    <h3 class="text-lg font-bold text-brand-900"><%= goal.exercise %></h3>
    <div class="flex items-center gap-1">
      <button
        onclick="editGoal(<%= JSON.stringify(goal.exercise) %>, <%= goal.current %>, <%= goal.target %>, <%= JSON.stringify(goal.targetDate ? new Date(goal.targetDate).toISOString().split('T')[0] : null) %>)"
        class="text-brand-600 hover:text-yellow-400 transition p-1.5"
        title="Edit"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
      </button>
      <button
        hx-delete="/api/goals/<%= goal.id %>"
        hx-target="#goal-<%= goal.id %>"
        hx-swap="outerHTML swap:1s"
        hx-confirm="Delete this goal?"
        class="text-brand-500 hover:text-red-500 transition p-1.5"
        title="Delete"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Progress Bar -->
  <%
    const progress = Math.min((goal.current / goal.target) * 100, 100);
    const remaining = goal.target - goal.current;
  %>

  <div class="space-y-2">
    <div class="flex justify-between items-center text-sm text-brand-700 mb-1">
      <span class="font-medium"><%= progress.toFixed(0) %>% Complete</span>
      <% if (remaining > 0) { %>
        <span><%= remaining %> <%= goal.unit %> to go</span>
      <% } else { %>
        <span class="text-green-600 font-semibold">Goal Achieved! 🎉</span>
      <% } %>
    </div>

    <div class="w-full bg-gray-800 rounded-full h-3">
      <div
        class="bg-yellow-500 h-3 rounded-full transition-all duration-500"
        style="width: <%= progress %>%"
      ></div>
    </div>

    <div class="flex justify-between text-sm text-brand-600">
      <span>Current: <%= goal.current %> <%= goal.unit %></span>
      <span>Target: <%= goal.target %> <%= goal.unit %></span>
    </div>

    <% if (goal.targetDate) { %>
      <%
        const targetDate = new Date(goal.targetDate);
        const today = new Date(); today.setHours(0, 0, 0, 0);
        const daysLeft = Math.ceil((targetDate.getTime() - today.getTime()) / (1000 * 60 * 60 * 24));
        const formattedTargetDate = targetDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      %>
      <div class="text-xs text-brand-500 pt-1">
        <% if (remaining <= 0) { %>
          Target date: <%= formattedTargetDate %>
        <% } else if (daysLeft < 0) { %>
          <span class="text-red-500">Target date was <%= formattedTargetDate %> — past due</span>
        <% } else if (daysLeft === 0) { %>
          <span class="text-yellow-500">Target date is today (<%= formattedTargetDate %>)</span>
        <% } else { %>
          Target date: <%= formattedTargetDate %> (<%= daysLeft %> day<%= daysLeft === 1 ? '' : 's' %> left)
        <% } %>
      </div>
    <% } %>
  </div>
</div>
