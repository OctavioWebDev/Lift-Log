<div class="px-6 py-4 hover:bg-gray-50 transition" id="workout-<%= workout.id %>">
  <div class="flex items-center justify-between">
    <div class="flex-1">
      <div class="flex items-center space-x-3 mb-1">
        <h3 class="text-lg font-bold text-brand-900"><%= workout.exercise %></h3>
        <span class="text-sm text-brand-500">
          <%= new Date(workout.date).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
        </span>
      </div>
      
      <p class="text-sm text-brand-600">
        <%= workout.sets %> sets × <%= workout.weight %> lbs × <%= workout.reps %> reps
        <% if (workout.rpe) { %>
          <span class="text-brand-500">• RPE <%= workout.rpe %></span>
        <% } %>
      </p>
    </div>
    
    <button
      hx-delete="/api/workout-sets/<%= workout.id %>"
      hx-target="#workout-<%= workout.id %>"
      hx-swap="outerHTML swap:1s"
      hx-confirm="Delete this workout set?"
      class="text-brand-500 hover:text-red-600 transition ml-4"
      title="Delete"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  </div>
</div>
