    <a href="/dashboard" data-tab="/dashboard" class="tab-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-brand-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span class="text-[11px] font-medium">Home</span>
    </a>
    <a href="/app" data-tab="/app" class="tab-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-brand-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
      </svg>
      <span class="text-[11px] font-medium">Log</span>
    </a>
    <a href="/progress" data-tab="/progress" class="tab-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-brand-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <span class="text-[11px] font-medium">Progress</span>
    </a>
    <a href="/nutrition" data-tab="/nutrition" class="tab-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-brand-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
      </svg>
      <span class="text-[11px] font-medium">Nutrition</span>
    </a>
    <a href="/goals" data-tab="/goals" class="tab-link flex-1 flex flex-col items-center justify-center gap-0.5 py-2 text-brand-500">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3v18M3 4a9 9 0 016 0 9 9 0 006 0v8a9 9 0 01-6 0 9 9 0 00-6 0V4z" />
