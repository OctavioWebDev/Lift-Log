<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>
    <%= typeof title !=='undefined' ? title : 'Chi-Rho Lifts' %>
  </title>

  <!-- PWA -->
  <link rel="manifest" href="/manifest.json">
  <link rel="icon" href="/icons/favicon-32.png" sizes="32x32">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
  <meta name="theme-color" content="#000000">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Chi-Rho Lifts">

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            // `brand` now backs TEXT (and ring/placeholder) tokens only, for
            // the black background theme — 900 is the brightest/most
            // prominent (headings), 50 the dimmest. Every bg-brand-*/
            // border-brand-* button-or-fill usage was converted to explicit
            // yellow-*/gray-* classes in the markup instead, since those want
            // gold, not this text ramp — see the retheme commit.
            'brand': {
              50: '#030712',
              100: '#111827',
              200: '#1f2937',
              300: '#374151',
              400: '#4b5563',
              500: '#6b7280',
              600: '#9ca3af',
              700: '#d1d5db',
              800: '#e5e7eb',
              900: '#ffffff',
            },
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    #bottom-tab-bar {
      padding-bottom: env(safe-area-inset-bottom);
    }

    #bottom-tab-bar .tab-link.active {
      color: #EAB308;
    }

    @media (max-width: 639px) {
      body.has-bottom-tabs main {
        padding-bottom: calc(5rem + env(safe-area-inset-bottom));
      }
    }
  </style>
</head>

<body class="bg-black<%= (typeof user !== 'undefined' && user) ? ' has-bottom-tabs' : '' %>">
  <nav class="bg-black border-b border-gray-800" style="padding-top: env(safe-area-inset-top);">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-14 sm:h-16">
        <!-- Logo -->
        <a href="<%= (typeof user !== 'undefined' && user) ? '/app' : '/' %>"
          class="text-lg sm:text-xl font-bold text-white hover:text-yellow-400 transition truncate">
          Chi-Rho Lifts
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-button" class="sm:hidden p-2 text-gray-300 hover:text-white"
