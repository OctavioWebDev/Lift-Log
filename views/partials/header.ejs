<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <%= typeof title !=='undefined' ? title : 'Lift-Log' %>
  </title>

  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@1.9.10"></script>

  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'brand': {
              50: '#f8f9fa',
              100: '#f1f3f5',
              200: '#e9ecef',
              300: '#dee2e6',
              400: '#ced4da',
              500: '#adb5bd',
              600: '#868e96',
              700: '#495057',
              800: '#343a40',
              900: '#212529',
            }
          }
        }
      }
    }
  </script>

  <style>
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }
  </style>
</head>

<body class="bg-gray-50">
  <nav class="bg-white border-b border-gray-200">
    <div class="px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-14 sm:h-16">
        <!-- Logo -->
        <a href="<%= (typeof user !== 'undefined' && user) ? '/app' : '/' %>"
          class="text-lg sm:text-xl font-bold text-brand-900 hover:text-brand-700 transition truncate">
          Lift-Log
        </a>

        <!-- Mobile Menu Button -->
        <button id="mobile-menu-button" class="sm:hidden p-2 text-brand-700 hover:text-brand-900"
          onclick="toggleMobileMenu()">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Desktop Navigation -->
        <div class="hidden sm:flex items-center space-x-6">
          <a href="/app" class="text-brand-700 hover:text-brand-900 font-medium transition text-sm lg:text-base">
            Workout Log
          </a>
          <a href="/dashboard" class="text-brand-700 hover:text-brand-900 font-medium transition text-sm lg:text-base">
            Dashboard
          </a>
          <a href="/goals" class="text-brand-700 hover:text-brand-900 font-medium transition text-sm lg:text-base">
            Goals
          </a>

          <!-- ← ADD ADMIN LINK HERE (Desktop) -->
          <% if (typeof user !=='undefined' && user && user.isAdmin) { %>
            <a href="/admin" class="text-brand-700 hover:text-brand-900 font-medium transition text-sm lg:text-base">
              Admin
            </a>
            <% } %>

              <!-- User Menu -->
              <div class="relative">
                <button id="user-menu-button" onclick="toggleUserMenu()"
                  class="flex items-center gap-2 text-brand-700 hover:text-brand-900 font-medium transition text-sm lg:text-base">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <% if (typeof user !=='undefined' && user) { %>
                    <%= user.username %>
                      <% } %>
                </button>

                <!-- Dropdown -->
                <div id="user-menu"
                  class="hidden absolute right-0 mt-2 w-48 bg-white rounded-lg border border-gray-200 shadow-lg py-1 z-50">
                  <div class="px-4 py-2 border-b border-gray-200">
                    <p class="text-sm font-medium text-brand-900">
                      <% if (typeof user !=='undefined' && user) { %>
                        <%= user.username %>
                          <% } %>
                    </p>
                    <% if (typeof user !=='undefined' && user && user.email) { %>
                      <p class="text-xs text-brand-600">
                        <%= user.email %>
                      </p>
                      <% } %>
                  </div>
                  <form action="/logout" method="POST">
                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                      Sign Out
                    </button>
                  </form>
                </div>
              </div>
        </div>
      </div>

      <!-- Mobile Menu Dropdown -->
      <div id="mobile-menu" class="hidden sm:hidden pb-3 space-y-1">
        <a href="/app"
          class="block px-3 py-2 text-brand-700 hover:bg-gray-50 hover:text-brand-900 rounded-lg font-medium">
          Workout Log
        </a>
        <a href="/dashboard"
          class="block px-3 py-2 text-brand-700 hover:bg-gray-50 hover:text-brand-900 rounded-lg font-medium">
          Dashboard
        </a>
        <a href="/goals"
          class="block px-3 py-2 text-brand-700 hover:bg-gray-50 hover:text-brand-900 rounded-lg font-medium">
          Goals
        </a>

        <!-- ← ADD ADMIN LINK HERE (Mobile) -->
        <% if (typeof user !=='undefined' && user && user.isAdmin) { %>
          <a href="/admin"
            class="block px-3 py-2 text-brand-700 hover:bg-gray-50 hover:text-brand-900 rounded-lg font-medium">
            Admin
          </a>
          <% } %>

            <div class="border-t border-gray-200 mt-2 pt-2">
              <div class="px-3 py-2 text-sm text-brand-900 font-medium">
                <% if (typeof user !=='undefined' && user) { %>
                  <%= user.username %>
                    <% } %>
              </div>
              <form action="/logout" method="POST">
                <button type="submit"
                  class="w-full text-left px-3 py-2 text-red-600 hover:bg-red-50 rounded-lg text-sm font-medium">
                  Sign Out
                </button>
              </form>
            </div>
      </div>
    </div>
  </nav>

  <main class="px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 max-w-7xl mx-auto">

    <script>
      function toggleMobileMenu() {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
      }

      function toggleUserMenu() {
        const menu = document.getElementById('user-menu');
        menu.classList.toggle('hidden');
      }

      // Close menus when clicking outside
      document.addEventListener('click', function (e) {
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileButton = document.getElementById('mobile-menu-button');
        const userMenu = document.getElementById('user-menu');
        const userButton = document.getElementById('user-menu-button');

        if (!mobileMenu.contains(e.target) && !mobileButton.contains(e.target)) {
          mobileMenu.classList.add('hidden');
        }

        if (userButton && userMenu && !userMenu.contains(e.target) && !userButton.contains(e.target)) {
          userMenu.classList.add('hidden');
        }
      });
    </script>