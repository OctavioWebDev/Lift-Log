  <script>
    (function highlightActiveTab() {
      const path = window.location.pathname;
      document.querySelectorAll('#bottom-tab-bar .tab-link').forEach((link) => {
        if (link.dataset.tab === path) link.classList.add('active');
      });
    })();
  </script>
  <% } %>

  <main class="px-4 sm:px-6 lg:px-8 py-4 sm:py-6 lg:py-8 max-w-7xl mx-auto">

    <script>
      function toggleMobileMenu() {
        const menu = document.getElementById('mobile-menu');
        menu.classList.toggle('hidden');
      }

      function toggleUserMenu() {
        const menu = document.getElementById('user-menu');
        menu.classList.toggle('hidden');
      }

      // Close menus when clicking outside
      document.addEventListener('click', function (e) {
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileButton = document.getElementById('mobile-menu-button');
        const userMenu = document.getElementById('user-menu');
        const userButton = document.getElementById('user-menu-button');

        if (!mobileMenu.contains(e.target) && !mobileButton.contains(e.target)) {
          mobileMenu.classList.add('hidden');
        }

        if (userButton && userMenu && !userMenu.contains(e.target) && !userButton.contains(e.target)) {
          userMenu.classList.add('hidden');
        }
      });

      // Shared "what does this mean?" popover for info icons next to jargon
      // like RPE or Est. 1RM — one popover element reused everywhere so each
      // call site only needs an icon + explanation string, no markup of its own.
      function showInfoTooltip(event, text) {
        event.preventDefault();
        event.stopPropagation();
        let tooltip = document.getElementById('global-info-tooltip');
        if (!tooltip) {
          tooltip = document.createElement('div');
          tooltip.id = 'global-info-tooltip';
          tooltip.className = 'fixed z-50 max-w-xs bg-gray-800 border border-gray-700 text-brand-900 text-xs leading-relaxed rounded-lg p-3 shadow-lg hidden';
          document.body.appendChild(tooltip);
        }
        const alreadyOpenForThis = tooltip.dataset.for === text && !tooltip.classList.contains('hidden');
        tooltip.classList.add('hidden');
        if (alreadyOpenForThis) return;

        tooltip.textContent = text;
        tooltip.dataset.for = text;
        tooltip.classList.remove('hidden');

        const btn = event.currentTarget;
        const rect = btn.getBoundingClientRect();
        const maxLeft = window.innerWidth - 272;
        const left = Math.min(rect.left, Math.max(8, maxLeft));
        tooltip.style.top = (rect.bottom + 6) + 'px';
        tooltip.style.left = left + 'px';
      }

      document.addEventListener('click', function (e) {
        const tooltip = document.getElementById('global-info-tooltip');
        if (tooltip && !tooltip.contains(e.target)) {
          tooltip.classList.add('hidden');
        }
      });

      // Eyeball toggle for password fields — shows/hides the typed password.
      function togglePasswordVisibility(inputId, btn) {
        const input = document.getElementById(inputId);
        const show = input.type === 'password';
        input.type = show ? 'text' : 'password';
        btn.querySelector('.eye-icon').classList.toggle('hidden', show);
        btn.querySelector('.eye-off-icon').classList.toggle('hidden', !show);
      }

      // Searchable exercise dropdown, shared by the workout log and goals
      // forms so exercise names always come from the same list (letting
      // goals match up with logged workouts by exact name).
      function setupExerciseSearch(searchId, valueId, dropdownId, optionClass) {
        const search = document.getElementById(searchId);
        const value = document.getElementById(valueId);
        const dropdown = document.getElementById(dropdownId);
        const options = dropdown.querySelectorAll('.' + optionClass);
        const headers = dropdown.querySelectorAll('.exercise-group-header');

        search.addEventListener('focus', () => {
          dropdown.classList.remove('hidden');
          options.forEach(o => o.style.display = '');
          headers.forEach(h => h.style.display = '');
        });

        search.addEventListener('input', () => {
          const q = search.value.toLowerCase().trim();
          if (!q) {
            options.forEach(o => o.style.display = '');
            headers.forEach(h => h.style.display = '');
            dropdown.classList.remove('hidden');
            return;
          }
          options.forEach(opt => {
            opt.style.display = opt.dataset.value.toLowerCase().includes(q) ? '' : 'none';
          });
          headers.forEach(header => {
            let next = header.nextElementSibling;
            let hasVisible = false;
            while (next && !next.classList.contains('exercise-group-header')) {
              if (next.style.display !== 'none') hasVisible = true;
              next = next.nextElementSibling;
            }
            header.style.display = hasVisible ? '' : 'none';
          });
          dropdown.classList.remove('hidden');
        });

        options.forEach(opt => {
          opt.addEventListener('mousedown', (e) => {
            e.preventDefault();
            search.value = opt.dataset.value;
            value.value = opt.dataset.value;
            dropdown.classList.add('hidden');
          });
        });

        search.addEventListener('blur', () => {
          setTimeout(() => dropdown.classList.add('hidden'), 200);
        });
      }
    </script>