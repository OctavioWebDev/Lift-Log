          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Desktop Navigation -->
        <div class="hidden sm:flex items-center space-x-6">
          <a href="/app" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Workout Log
          </a>
          <a href="/dashboard" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Dashboard
          </a>
          <a href="/progress" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Progress
          </a>
          <a href="/goals" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Goals
          </a>
          <a href="/meet-prep" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Meet Prep
          </a>
          <a href="/nutrition" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Nutrition
          </a>
          <a href="/billing" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
            Billing
          </a>

          <!-- ← ADD ADMIN LINK HERE (Desktop) -->
          <% if (typeof user !=='undefined' && user && user.isAdmin) { %>
            <a href="/admin" class="text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
              Admin
            </a>
            <% } %>

              <!-- User Menu -->
              <div class="relative">
                <button id="user-menu-button" onclick="toggleUserMenu()"
                  class="flex items-center gap-2 text-gray-300 hover:text-yellow-400 font-medium transition text-sm lg:text-base">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                  </svg>
                  <% if (typeof user !=='undefined' && user) { %>
                    <%= user.username %>
                      <% } %>
                </button>

                <!-- Dropdown -->
                <div id="user-menu"
                  class="hidden absolute right-0 mt-2 w-48 bg-gray-900 rounded-lg border border-gray-800 shadow-lg py-1 z-50">
                  <div class="px-4 py-2 border-b border-gray-800">
                    <p class="text-sm font-medium text-brand-900">
                      <% if (typeof user !=='undefined' && user) { %>
                        <%= user.username %>
                          <% } %>
                    </p>
                    <% if (typeof user !=='undefined' && user && user.email) { %>
                      <p class="text-xs text-brand-600">
                        <%= user.email %>
                      </p>
                      <% } %>
                  </div>
                  <a href="/profile" class="block px-4 py-2 text-sm text-brand-700 hover:bg-gray-800 hover:text-yellow-400">
                    Profile
                  </a>
                  <a href="/account/change-password" class="block px-4 py-2 text-sm text-brand-700 hover:bg-gray-800 hover:text-yellow-400">
                    Change Password
                  </a>
                  <form action="/logout" method="POST">
                    <button type="submit" class="w-full text-left px-4 py-2 text-sm text-red-400 hover:bg-gray-800">
                      Sign Out
                    </button>
                  </form>
                </div>
              </div>
        </div>
      </div>

      <!-- Mobile Menu Dropdown — primary nav lives in the bottom tab bar now;
           this keeps only the less-frequent links. -->
      <div id="mobile-menu" class="hidden sm:hidden pb-3 space-y-1">
        <a href="/meet-prep"
          class="block px-3 py-2 text-brand-700 hover:bg-gray-800 hover:text-yellow-400 rounded-lg font-medium">
          Meet Prep
        </a>
        <a href="/billing"
          class="block px-3 py-2 text-brand-700 hover:bg-gray-800 hover:text-yellow-400 rounded-lg font-medium">
          Billing
        </a>

        <!-- ← ADD ADMIN LINK HERE (Mobile) -->
        <% if (typeof user !=='undefined' && user && user.isAdmin) { %>
          <a href="/admin"
            class="block px-3 py-2 text-brand-700 hover:bg-gray-800 hover:text-yellow-400 rounded-lg font-medium">
            Admin
          </a>
          <% } %>

            <div class="border-t border-gray-800 mt-2 pt-2">
              <div class="px-3 py-2 text-sm text-brand-900 font-medium">
                <% if (typeof user !=='undefined' && user) { %>
                  <%= user.username %>
                    <% } %>
              </div>
              <a href="/profile"
                class="block px-3 py-2 text-brand-700 hover:bg-gray-800 hover:text-yellow-400 rounded-lg font-medium">
                Profile
              </a>
              <a href="/account/change-password"
                class="block px-3 py-2 text-brand-700 hover:bg-gray-800 hover:text-yellow-400 rounded-lg font-medium">
                Change Password
              </a>
              <form action="/logout" method="POST">
                <button type="submit"
                  class="w-full text-left px-3 py-2 text-red-400 hover:bg-gray-800 rounded-lg text-sm font-medium">
                  Sign Out
                </button>
              </form>
            </div>
      </div>
    </div>
  </nav>

  <!-- Bottom Tab Bar — mobile only, primary app navigation (native-app style) -->
