<%- include('partials/header') %>

<div class="max-w-lg mx-auto space-y-6">

  <% if (status === 'active') { %>
  <!-- Active subscription -->
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h1 class="text-2xl font-bold text-brand-900 mb-1">Subscription</h1>
    <div class="mt-4 bg-green-50 border border-green-200 rounded-lg p-4">
      <p class="text-green-700 font-medium">
        Your subscription is active.
        <% if (periodEndsAt) { %>
          Renews on <%= new Date(periodEndsAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>.
        <% } %>
      </p>
    </div>

    <% if (user.stripeSubscriptionId) { %>
    <div class="mt-6">
      <form action="/billing/cancel" method="POST">
        <button type="submit" onclick="return confirm('Are you sure you want to cancel? You will keep access until the end of your billing period.')"
          class="px-6 py-2 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 transition text-sm">
          Cancel Subscription
        </button>
      </form>
    </div>
    <% } %>
  </div>

  <% } else { %>
  <!-- Paywall -->
  <div class="bg-white rounded-lg border-2 border-brand-900 p-8 text-center">
    <h1 class="text-3xl font-bold text-brand-900 mb-2">Get Full Access</h1>
    <p class="text-brand-600 mb-6">Start tracking your strength journey with Lift-Log.</p>

    <% if (error) { %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-3 mb-6">
      <p class="text-red-700 text-sm">Something went wrong. Please try again.</p>
    </div>
    <% } %>

    <div class="mb-8">
      <p class="text-5xl font-bold text-brand-900">$120</p>
      <p class="text-brand-600 mt-1">per year &mdash; cancel anytime</p>
    </div>

    <ul class="text-left space-y-3 text-sm text-brand-700 mb-8">
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Unlimited workout logging
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Goal tracking
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Calorie & macro tracking
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Full dashboard & history
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Community features (coming soon)
      </li>
    </ul>

    <form action="/billing/checkout" method="POST">
      <button type="submit"
        class="w-full bg-brand-900 hover:bg-brand-800 text-white font-semibold py-4 rounded-lg transition text-lg">
        Subscribe for $120/yr
      </button>
    </form>

    <p class="text-xs text-brand-500 mt-4">Secure payment via Stripe. Cancel anytime.</p>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>
