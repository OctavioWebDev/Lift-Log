<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h1 class="text-3xl font-bold text-brand-900 mb-1">Billing</h1>
    <p class="text-brand-600">Manage your Lift-Log subscription</p>
  </div>

  <% if (expired) { %>
  <div class="bg-red-50 border border-red-200 rounded-lg p-4">
    <p class="text-red-700 font-medium">Your trial or subscription has expired. Choose a plan below to continue.</p>
  </div>
  <% } %>

  <% if (status === 'trial') { %>
  <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
    <p class="text-blue-700 font-medium">
      You're on a free trial. 
      <% if (trialDaysLeft > 0) { %>
        <%= trialDaysLeft %> day(s) remaining.
      <% } else { %>
        Your trial has expired.
      <% } %>
    </p>
  </div>
  <% } %>

  <% if (status === 'active' && user.subscriptionInterval !== 'lifetime') { %>
  <div class="bg-green-50 border border-green-200 rounded-lg p-4">
    <p class="text-green-700 font-medium">
      Your subscription is active (<%= user.subscriptionInterval %>).
      <% if (periodEndsAt) { %>
        Renews on <%= new Date(periodEndsAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' }) %>.
      <% } %>
    </p>
  </div>
  <% } %>

  <!-- Pricing Plans -->
  <% if (status !== 'active' || user.subscriptionInterval === 'trial') { %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <!-- Monthly Plan -->
    <div class="bg-white rounded-lg border border-gray-200 p-6">
      <h2 class="text-xl font-bold text-brand-900 mb-2">Monthly</h2>
      <p class="text-4xl font-bold text-brand-900 mb-1">$10<span class="text-lg font-normal text-brand-600">/mo</span></p>
      <p class="text-brand-600 mb-6">Billed monthly. Cancel anytime.</p>
      <ul class="space-y-2 text-sm text-brand-700 mb-6">
        <li>✅ Unlimited workout logging</li>
        <li>✅ Goal tracking</li>
        <li>✅ Full dashboard</li>
        <li>✅ Auto-renews monthly</li>
      </ul>
      <form action="/billing/checkout" method="POST">
        <input type="hidden" name="interval" value="monthly">
        <button type="submit" class="w-full bg-brand-900 hover:bg-brand-800 text-white font-semibold py-3 rounded-lg transition">
          Subscribe Monthly
        </button>
      </form>
    </div>

    <!-- Annual Plan -->
    <div class="bg-white rounded-lg border-2 border-brand-900 p-6 relative">
      <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand-900 text-white text-xs font-bold px-3 py-1 rounded-full">BEST VALUE</span>
      <h2 class="text-xl font-bold text-brand-900 mb-2">Annual</h2>
      <p class="text-4xl font-bold text-brand-900 mb-1">$120<span class="text-lg font-normal text-brand-600">/yr</span></p>
      <p class="text-brand-600 mb-6">2 months free vs monthly.</p>
      <ul class="space-y-2 text-sm text-brand-700 mb-6">
        <li>✅ Unlimited workout logging</li>
        <li>✅ Goal tracking</li>
        <li>✅ Full dashboard</li>
        <li>✅ Auto-renew optional</li>
      </ul>
      <form action="/billing/checkout" method="POST">
        <input type="hidden" name="interval" value="annual">
        <button type="submit" class="w-full bg-brand-900 hover:bg-brand-800 text-white font-semibold py-3 rounded-lg transition">
          Subscribe Annually
        </button>
      </form>
    </div>
  </div>
  <% } %>

  <!-- Cancel Subscription -->
  <% if (status === 'active' && user.subscriptionInterval !== 'lifetime' && user.stripeSubscriptionId) { %>
  <div class="bg-white rounded-lg border border-gray-200 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-2">Cancel Subscription</h2>
    <p class="text-brand-600 mb-4">You'll keep access until the end of your billing period.</p>
    <form action="/billing/cancel" method="POST">
      <button type="submit" onclick="return confirm('Are you sure you want to cancel?')" class="px-6 py-2 border border-red-300 text-red-600 rounded-lg hover:bg-red-50 transition">
        Cancel Subscription
      </button>
    </form>
  </div>
  <% } %>
</div>

<%- include('partials/footer') %>