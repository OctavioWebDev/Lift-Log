<%- include('partials/header') %>

<div class="max-w-lg mx-auto space-y-6">

  <% if (status === 'active') { %>
  <!-- Active — lifetime access -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h1 class="text-2xl font-bold text-brand-900 mb-1">Your Access</h1>
    <div class="mt-4 bg-green-950 border border-green-900 rounded-lg p-4">
      <p class="text-green-400 font-medium">✓ You have lifetime access to Chi-Rho Lifts.</p>
    </div>
    <p class="text-sm text-brand-500 mt-4">Thank you for your support. Your one-time purchase gives you permanent access to all current features and future updates.</p>
  </div>

  <% } else { %>
  <!-- Paywall -->
  <div class="bg-gray-900 rounded-lg border-2 border-yellow-500 p-8 text-center">
    <h1 class="text-3xl font-bold text-brand-900 mb-2">Get Lifetime Access</h1>
    <p class="text-brand-600 mb-6">One payment. Yours forever. Start tracking your strength journey today.</p>

    <% if (error) { %>
    <div class="bg-red-950 border border-red-900 rounded-lg p-3 mb-6">
      <p class="text-red-400 text-sm">Something went wrong. Please try again.</p>
    </div>
    <% } %>

    <div class="mb-8">
      <p class="text-5xl font-bold text-brand-900">$120</p>
      <p class="text-brand-600 mt-1">one-time payment &mdash; lifetime access</p>
    </div>

    <ul class="text-left space-y-3 text-sm text-brand-700 mb-8">
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Unlimited workout logging
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Goal tracking & progress history
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Calorie & macro tracking
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Full dashboard & analytics
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> All future updates included
      </li>
      <li class="flex items-center gap-2">
        <span class="text-green-600 font-bold">✓</span> Community features (coming soon)
      </li>
    </ul>

    <form action="/billing/checkout" method="POST">
      <button type="submit"
        class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-semibold py-4 rounded-lg transition text-lg">
        Get Lifetime Access — $120
      </button>
    </form>

    <p class="text-xs text-brand-500 mt-4">Secure payment via Stripe. One-time charge, no recurring fees.</p>
  </div>
  <% } %>

</div>

<%- include('partials/footer') %>
