<%- include('partials/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<div class="space-y-4">

  <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
    <h1 class="text-2xl font-bold text-brand-900 mb-1">Progress</h1>
    <p class="text-sm text-brand-600">Track your strength over time, one exercise at a time.</p>
  </div>

  <% if (exercises.length === 0) { %>
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-12 text-center">
      <p class="text-brand-600">No workouts logged yet. Once you log a few sets, your progress chart will show up here.</p>
      <a href="/app" class="inline-block mt-4 text-sm font-medium text-brand-700 hover:text-yellow-400">Log a workout →</a>
    </div>
  <% } else { %>

    <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
        <label for="exercise-select" class="text-sm font-medium text-brand-700 whitespace-nowrap">Exercise</label>
        <select id="exercise-select"
          class="w-full sm:w-64 bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500">
          <% exercises.forEach(function(ex) { %>
            <option value="<%= ex %>" <%= ex === defaultExercise ? 'selected' : '' %>><%= ex %></option>
          <% }); %>
        </select>
        <span id="strongest-badge" class="hidden text-xs font-medium text-yellow-500 whitespace-nowrap">🏆 Your strongest lift</span>
      </div>

      <div class="grid grid-cols-3 gap-4 mb-4">
        <div class="bg-black rounded-lg p-3 text-center">
          <p class="text-2xl font-bold text-brand-900" id="stat-current-1rm">—</p>
          <p class="flex items-center justify-center gap-1 text-xs text-brand-500 uppercase tracking-wide mt-1">
            Est. 1RM
            <button type="button" onclick="showInfoTooltip(event, 'Estimated 1-Rep Max: the heaviest single lift you could likely do, calculated from the weight and reps of a set (Epley formula). It is an estimate, not a tested max.')" class="text-brand-500 hover:text-yellow-500 normal-case" aria-label="What is Est. 1RM?">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" stroke-width="2" />
                <path stroke-linecap="round" stroke-width="2" d="M12 16v-4m0-4h.01" />
              </svg>
            </button>
          </p>
        </div>
        <div class="bg-black rounded-lg p-3 text-center">
          <p class="text-2xl font-bold text-brand-900" id="stat-best-set">—</p>
          <p class="text-xs text-brand-500 uppercase tracking-wide mt-1">Best Set</p>
        </div>
        <div class="bg-black rounded-lg p-3 text-center">
          <p class="text-2xl font-bold text-brand-900" id="stat-total-sessions">—</p>
          <p class="text-xs text-brand-500 uppercase tracking-wide mt-1">Sessions</p>
        </div>
      </div>

      <div id="chart-empty" class="hidden py-12 text-center text-brand-500 text-sm">
        Not enough data yet for this exercise.
      </div>
      <div style="position: relative; height: 320px;">
        <canvas id="exercise-chart"></canvas>
      </div>
      <p class="text-xs text-brand-400 mt-3">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-white border-2 border-yellow-500 align-middle mr-1"></span>
        White points mark a new estimated-1RM personal record.
      </p>
    </div>

  <% } %>
</div>

<script>
  let chart = null;

  function estimatedOneRepMax(weight, reps) {
    return Math.round(weight * (1 + reps / 30));
  }

  async function loadExercise(exercise) {
    const res = await fetch(`/api/stats/exercise-history?exercise=${encodeURIComponent(exercise)}`);
    const points = await res.json();

    const emptyEl = document.getElementById('chart-empty');
    const canvasWrap = document.getElementById('exercise-chart').parentElement;

    if (!points.length) {
      emptyEl.classList.remove('hidden');
      canvasWrap.classList.add('hidden');
      document.getElementById('stat-current-1rm').textContent = '—';
      document.getElementById('stat-best-set').textContent = '—';
      document.getElementById('stat-total-sessions').textContent = '0';
      if (chart) { chart.destroy(); chart = null; }
      return;
    }
    emptyEl.classList.add('hidden');
    canvasWrap.classList.remove('hidden');

    // Keep the best set (highest estimated 1RM) per day.
    const byDate = new Map();
    for (const p of points) {
      const existing = byDate.get(p.date);
      if (!existing || p.estimatedOneRepMax > existing.estimatedOneRepMax) byDate.set(p.date, p);
    }
    const sorted = Array.from(byDate.values()).sort((a, b) => a.date.localeCompare(b.date));

    const labels = sorted.map(p => p.date);
    const oneRms = sorted.map(p => p.estimatedOneRepMax);
    const weights = sorted.map(p => p.weight);

    // Mark points that set a new all-time-high estimated 1RM.
    let runningMax = -Infinity;
    const prFlags = oneRms.map(v => {
      const isPr = v > runningMax;
      if (isPr) runningMax = v;
      return isPr;
    });

    const bestSet = sorted[sorted.length - 1];
    const allTimeBest = Math.max(...oneRms);
    document.getElementById('stat-current-1rm').textContent = allTimeBest + ' lbs';
    document.getElementById('stat-best-set').textContent = bestSet.weight + '×' + bestSet.reps;
    document.getElementById('stat-total-sessions').textContent = sorted.length;

    if (chart) chart.destroy();
    const ctx = document.getElementById('exercise-chart').getContext('2d');
    chart = new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'Estimated 1RM',
            data: oneRms,
            borderColor: '#EAB308',
            backgroundColor: 'rgba(234, 179, 8, 0.12)',
            pointBackgroundColor: prFlags.map(isPr => isPr ? '#ffffff' : '#EAB308'),
            pointBorderColor: prFlags.map(isPr => isPr ? '#EAB308' : '#EAB308'),
            pointBorderWidth: prFlags.map(isPr => isPr ? 2 : 1),
            pointRadius: prFlags.map(isPr => isPr ? 6 : 3),
            pointHoverRadius: 7,
            fill: true,
            tension: 0.25,
          },
          {
            label: 'Top Set Weight',
            data: weights,
            borderColor: '#6b7280',
            backgroundColor: 'transparent',
            borderDash: [4, 4],
            pointRadius: 2,
            tension: 0.25,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { position: 'top', labels: { boxWidth: 12, font: { size: 12 }, color: '#d1d5db' } },
        },
        scales: {
          x: { ticks: { color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.06)' } },
          y: { ticks: { color: '#9ca3af', callback: (v) => v + ' lbs' }, grid: { color: 'rgba(255,255,255,0.06)' } },
        },
      },
    });
  }

  const defaultExercise = <%- JSON.stringify(defaultExercise || null) %>;
  const select = document.getElementById('exercise-select');
  const strongestBadge = document.getElementById('strongest-badge');

  function updateStrongestBadge() {
    if (!strongestBadge) return;
    strongestBadge.classList.toggle('hidden', !defaultExercise || select.value !== defaultExercise);
  }

  if (select) {
    select.addEventListener('change', () => {
      loadExercise(select.value);
      updateStrongestBadge();
    });
    if (select.value) {
      loadExercise(select.value);
      updateStrongestBadge();
    }
  }
</script>

<%- include('partials/footer') %>
