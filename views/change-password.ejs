<%- include('partials/header') %>

<div class="max-w-md mx-auto space-y-6">

  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h1 class="text-2xl font-bold text-brand-900 mb-1">Change Password</h1>
    <% if (forced) { %>
      <p class="text-sm text-brand-600">Set your own password to replace the temporary one you were given.</p>
    <% } else { %>
      <p class="text-sm text-brand-600">Update the password for your account.</p>
    <% } %>
  </div>

  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6 sm:p-8">
    <% if (error) { %>
      <div class="mb-4 p-3 bg-red-950 border border-red-900 rounded-lg text-red-400 text-sm">
        <%= error %>
      </div>
    <% } %>

    <form action="/account/change-password" method="POST" class="space-y-4">
      <div>
        <label for="currentPassword" class="block text-sm font-medium text-brand-700 mb-1">
          <%= forced ? 'Temporary Password' : 'Current Password' %>
        </label>
        <div class="relative">
          <input
            type="password"
            id="currentPassword"
            name="currentPassword"
            required
            autofocus
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 pr-10 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
          <button type="button" onclick="togglePasswordVisibility('currentPassword', this)" tabindex="-1" aria-label="Show password"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-brand-500 hover:text-brand-700">
            <svg class="eye-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg class="eye-off-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21" />
            </svg>
          </button>
        </div>
      </div>

      <div>
        <label for="newPassword" class="block text-sm font-medium text-brand-700 mb-1">
          New Password
        </label>
        <div class="relative">
          <input
            type="password"
            id="newPassword"
            name="newPassword"
            required
            minlength="8"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 pr-10 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
          <button type="button" onclick="togglePasswordVisibility('newPassword', this)" tabindex="-1" aria-label="Show password"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-brand-500 hover:text-brand-700">
            <svg class="eye-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg class="eye-off-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21" />
            </svg>
          </button>
        </div>
        <p class="mt-1 text-xs text-brand-500">Minimum 8 characters</p>
      </div>

      <div>
        <label for="confirmPassword" class="block text-sm font-medium text-brand-700 mb-1">
          Confirm New Password
        </label>
        <div class="relative">
          <input
            type="password"
            id="confirmPassword"
            name="confirmPassword"
            required
            minlength="8"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 pr-10 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
          <button type="button" onclick="togglePasswordVisibility('confirmPassword', this)" tabindex="-1" aria-label="Show password"
            class="absolute inset-y-0 right-0 flex items-center pr-3 text-brand-500 hover:text-brand-700">
            <svg class="eye-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
            <svg class="eye-off-icon w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.542-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.878 9.878L3 3m6.878 6.878L21 21" />
            </svg>
          </button>
        </div>
      </div>

      <button
        type="submit"
        class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-semibold py-3 rounded-lg transition"
      >
        Update Password
      </button>
    </form>
  </div>

</div>

<%- include('partials/footer') %>
