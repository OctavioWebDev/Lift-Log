<%- include('partials/header') %>

<div class="max-w-2xl mx-auto space-y-6">
  <!-- Page Header -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h1 class="text-3xl font-bold text-brand-900 mb-1">Profile</h1>
    <p class="text-brand-600">Manage your account and lifter info.</p>
  </div>

  <!-- Profile Picture -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-4">Profile Picture</h2>

    <% if (typeof avatarError !== 'undefined' && avatarError) { %>
      <div class="mb-4 p-3 bg-red-950 border border-red-900 rounded-lg text-red-400 text-sm">
        <%= avatarError %>
      </div>
    <% } %>
    <% if (typeof avatarSuccess !== 'undefined' && avatarSuccess) { %>
      <div class="mb-4 p-3 bg-green-950 border border-green-900 rounded-lg text-green-400 text-sm">
        Profile picture updated.
      </div>
    <% } %>

    <div class="flex items-center gap-4">
      <% if (profileUser.avatarUrl) { %>
        <img src="<%= profileUser.avatarUrl %>" alt="Profile picture" class="w-20 h-20 rounded-full object-cover border border-gray-700">
      <% } else { %>
        <div class="w-20 h-20 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-brand-500">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
          </svg>
        </div>
      <% } %>

      <div class="flex-1 space-y-2">
        <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="flex flex-wrap items-center gap-2">
          <input type="file" name="avatar" accept="image/jpeg,image/png,image/webp,image/gif" required
            class="text-sm text-brand-700 file:mr-3 file:py-2 file:px-3 file:rounded-lg file:border-0 file:bg-gray-800 file:text-brand-700 file:text-sm hover:file:bg-gray-700 file:cursor-pointer cursor-pointer">
          <button type="submit" class="bg-yellow-500 hover:bg-yellow-600 text-black font-semibold px-4 py-2 rounded-lg transition text-sm">
            Upload
          </button>
        </form>
        <p class="text-xs text-brand-500">JPEG, PNG, WEBP, or GIF. Max 5MB.</p>
        <% if (profileUser.avatarUrl) { %>
          <form action="/profile/avatar/remove" method="POST">
            <button type="submit" class="text-xs font-medium text-red-500 hover:text-red-400 transition">
              Remove picture
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Account Info -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-4">Account Info</h2>

    <% if (accountError) { %>
      <div class="mb-4 p-3 bg-red-950 border border-red-900 rounded-lg text-red-400 text-sm">
        <%= accountError %>
      </div>
    <% } %>
    <% if (accountSuccess) { %>
      <div class="mb-4 p-3 bg-green-950 border border-green-900 rounded-lg text-green-400 text-sm">
        Account info updated.
      </div>
    <% } %>

    <form action="/profile/account" method="POST" class="space-y-4">
      <div>
        <label for="username" class="block text-sm font-medium text-brand-700 mb-1">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          value="<%= profileUser.username %>"
          required
          minlength="3"
          maxlength="30"
          pattern="[a-zA-Z0-9_-]+"
          class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
        >
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-brand-700 mb-1">Email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= profileUser.email || '' %>"
          placeholder="your@email.com"
          class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500"
        >
      </div>

      <button type="submit" class="w-full sm:w-auto bg-yellow-500 hover:bg-yellow-600 text-black font-semibold px-6 py-2.5 rounded-lg transition">
        Save Account Info
      </button>
    </form>

    <div class="mt-4 pt-4 border-t border-gray-800">
      <a href="/account/change-password" class="text-sm font-medium text-brand-700 hover:text-yellow-400 transition">
        Change Password →
      </a>
    </div>
  </div>

  <!-- Lifter Profile -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <h2 class="text-xl font-bold text-brand-900 mb-4">Lifter Profile</h2>

    <% if (lifterError) { %>
      <div class="mb-4 p-3 bg-red-950 border border-red-900 rounded-lg text-red-400 text-sm">
        <%= lifterError %>
      </div>
    <% } %>
    <% if (lifterSuccess) { %>
      <div class="mb-4 p-3 bg-green-950 border border-green-900 rounded-lg text-green-400 text-sm">
        Lifter profile updated.
      </div>
    <% } %>

    <form action="/profile/lifter-info" method="POST" class="space-y-4">
      <div>
        <label for="fullName" class="block text-sm font-medium text-brand-700 mb-1">Full Name</label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          value="<%= profileUser.fullName || '' %>"
          placeholder="Your name"
          class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500"
        >
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="dateOfBirth" class="block text-sm font-medium text-brand-700 mb-1">Date of Birth</label>
          <input
            type="date"
            id="dateOfBirth"
            name="dateOfBirth"
            value="<%= profileUser.dateOfBirth ? new Date(profileUser.dateOfBirth).toISOString().split('T')[0] : '' %>"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
        </div>
        <div>
          <label for="sex" class="block text-sm font-medium text-brand-700 mb-1">Sex</label>
          <select
            id="sex"
            name="sex"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
            <option value="" <%= !profileUser.sex ? 'selected' : '' %>>Prefer not to say</option>
            <option value="male" <%= profileUser.sex === 'male' ? 'selected' : '' %>>Male</option>
            <option value="female" <%= profileUser.sex === 'female' ? 'selected' : '' %>>Female</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="bodyweight" class="block text-sm font-medium text-brand-700 mb-1">Bodyweight (lbs)</label>
          <input
            type="number"
            id="bodyweight"
            name="bodyweight"
            min="1"
            step="0.1"
            value="<%= profileUser.bodyweight || '' %>"
            placeholder="180"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
        </div>
        <div>
          <label for="heightInches" class="block text-sm font-medium text-brand-700 mb-1">Height (inches)</label>
          <input
            type="number"
            id="heightInches"
            name="heightInches"
            min="1"
            step="0.1"
            value="<%= profileUser.heightInches || '' %>"
            placeholder="70"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500"
          >
          <p class="mt-1 text-xs text-brand-500">e.g. 70 for 5'10"</p>
        </div>
      </div>

      <button type="submit" class="w-full sm:w-auto bg-yellow-500 hover:bg-yellow-600 text-black font-semibold px-6 py-2.5 rounded-lg transition">
        Save Lifter Profile
      </button>
    </form>
  </div>
</div>

<%- include('partials/footer') %>
