<div class="border rounded-lg p-4" id="goal-<%= goal.id %>">
  <div class="flex items-center justify-between mb-3">
    <h4 class="text-lg font-semibold text-gray-900"><%= goal.exercise %></h4>
    <button
      hx-delete="/api/goals/<%= goal.id %>"
      hx-target="#goal-<%= goal.id %>"
      hx-swap="outerHTML swap:1s"
      hx-confirm="Delete this goal?"
      class="text-red-600 hover:text-red-800"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    </button>
  </div>
  
  <!-- Progress Bar -->
  <% 
    const progress = Math.min((goal.current / goal.target) * 100, 100);
    const remaining = goal.target - goal.current;
  %>
  
  <div class="space-y-2">
    <div class="flex justify-between text-sm text-gray-600">
      <span>Current: <%= goal.current %> <%= goal.unit %></span>
      <span>Target: <%= goal.target %> <%= goal.unit %></span>
    </div>
    
    <div class="w-full bg-gray-200 rounded-full h-3">
      <div 
        class="bg-blue-600 h-3 rounded-full transition-all duration-500"
        style="width: <%= progress %>%"
      ></div>
    </div>
    
    <div class="text-sm text-gray-500">
      <% if (remaining > 0) { %>
        <%= remaining %> <%= goal.unit %> to go (<%= progress.toFixed(1) %>%)
      <% } else { %>
        <span class="text-green-600 font-semibold">Goal achieved! 🎉</span>
      <% } %>
    </div>
  </div>
</div>
