<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Header -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <a href="/admin" class="text-sm text-brand-600 hover:text-yellow-400 transition">&larr; Back to Admin Panel</a>
    <div class="flex items-start justify-between gap-3 mt-2">
      <div class="flex items-center gap-3">
        <% if (targetUser.avatarUrl) { %>
          <img src="<%= targetUser.avatarUrl %>" alt="" class="w-14 h-14 rounded-full object-cover border border-gray-700">
        <% } else { %>
          <div class="w-14 h-14 rounded-full bg-gray-800 border border-gray-700 flex items-center justify-center text-brand-500">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
          </div>
        <% } %>
        <div>
          <div class="flex items-center gap-2 flex-wrap">
            <h1 class="text-2xl font-bold text-brand-900"><%= targetUser.fullName || targetUser.username %></h1>
            <% if (targetUser.isAdmin) { %>
              <span class="text-xs bg-yellow-500 text-black px-2 py-0.5 rounded">Admin</span>
            <% } %>
            <% if (!targetUser.isAdmin && targetUser.subscriptionInterval === 'lifetime') { %>
              <span class="text-xs bg-gray-700 text-brand-900 px-2 py-0.5 rounded">Free (Coaching)</span>
            <% } %>
            <span class="text-xs <%= subscriptionStatus === 'active' ? 'bg-green-950 text-green-400' : 'bg-red-950 text-red-400' %> px-2 py-0.5 rounded capitalize">
              <%= subscriptionStatus %>
            </span>
          </div>
          <p class="text-sm text-brand-600">
            @<%= targetUser.username %><% if (targetUser.email) { %> &middot; <%= targetUser.email %><% } %>
          </p>
          <p class="text-xs text-brand-500 mt-1">
            Joined <%= new Date(targetUser.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-4">
      <p class="text-xs sm:text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">Total Workouts</p>
      <p class="text-2xl sm:text-3xl font-bold text-brand-900"><%= stats.totalWorkouts %></p>
    </div>
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-4">
      <p class="text-xs sm:text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">This Week</p>
      <p class="text-2xl sm:text-3xl font-bold text-brand-900"><%= stats.workoutsThisWeek %></p>
    </div>
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-4">
      <p class="text-xs sm:text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">Total Volume</p>
      <p class="text-2xl sm:text-3xl font-bold text-brand-900"><%= stats.totalVolume.toLocaleString() %></p>
    </div>
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-4">
      <p class="text-xs sm:text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">Active Goals</p>
      <p class="text-2xl sm:text-3xl font-bold text-brand-900"><%= stats.activeGoals %></p>
    </div>
  </div>

  <!-- Best Lifts -->
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-800">
      <h2 class="text-lg sm:text-xl font-bold text-brand-900">Best Lifts</h2>
    </div>
    <div class="divide-y divide-gray-800">
      <% if (bestLifts.length === 0) { %>
        <p class="text-center text-brand-600 py-8">No workouts logged yet.</p>
      <% } else { %>
        <% bestLifts.forEach(function(lift) { %>
          <div class="px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-brand-900"><%= lift.exercise %></p>
              <p class="text-xs text-brand-600"><%= lift.weight %> lbs &times; <%= lift.reps %></p>
            </div>
            <div class="text-right">
              <p class="text-sm font-bold text-yellow-500"><%= lift.estimatedOneRepMax %> lbs</p>
              <p class="text-xs text-brand-500">est. 1RM</p>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <!-- Goals -->
  <% if (goals.length > 0) { %>
    <div class="bg-gray-900 rounded-lg border border-gray-800">
      <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-800">
        <h2 class="text-lg sm:text-xl font-bold text-brand-900">Goals</h2>
      </div>
      <div class="divide-y divide-gray-800">
        <% goals.forEach(function(goal) { %>
          <% const progress = Math.min((goal.current / goal.target) * 100, 100); %>
          <div class="px-4 sm:px-6 py-3 sm:py-4">
            <div class="flex justify-between items-center mb-2">
              <h3 class="font-bold text-brand-900 text-sm sm:text-base"><%= goal.exercise %></h3>
              <span class="text-xs sm:text-sm font-medium text-brand-600"><%= progress.toFixed(0) %>%</span>
            </div>
            <div class="w-full bg-gray-800 rounded-full h-2 mb-2">
              <div class="bg-yellow-500 h-2 rounded-full" style="width: <%= progress %>%"></div>
            </div>
            <div class="flex justify-between text-xs sm:text-sm text-brand-600">
              <span><%= goal.current %> <%= goal.unit %></span>
              <span><%= goal.target %> <%= goal.unit %></span>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Recent Workouts -->
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-800">
      <div class="flex items-center justify-between">
        <h2 class="text-lg sm:text-xl font-bold text-brand-900">Recent Workouts</h2>
        <span class="text-xs sm:text-sm text-brand-600 bg-gray-800 px-2 py-1 rounded"><%= recentWorkouts.length %> shown</span>
      </div>
    </div>
    <div class="divide-y divide-gray-800">
      <% if (recentWorkouts.length === 0) { %>
        <p class="text-center text-brand-600 py-8">No workouts logged yet.</p>
      <% } else { %>
        <% recentWorkouts.forEach(function(workout) { %>
          <div class="px-4 sm:px-6 py-3 flex items-center justify-between gap-3">
            <div>
              <p class="text-sm font-medium text-brand-900">
                <%= workout.exercise %>
                <% if (workout.meetPrepId) { %>
                  <span class="text-xs font-normal bg-gray-800 text-brand-500 px-1.5 py-0.5 rounded align-middle">Plan</span>
                <% } %>
              </p>
              <p class="text-xs text-brand-600">
                <%= workout.sets %> &times; <%= workout.weight %> lbs &times; <%= workout.reps %> reps
                <% if (workout.rpe) { %> &middot; RPE <%= workout.rpe %><% } %>
              </p>
            </div>
            <span class="text-xs text-brand-500 whitespace-nowrap">
              <%= new Date(workout.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
            </span>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
