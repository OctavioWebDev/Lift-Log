<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign Up - Lift-Log</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'brand': {
              50: '#f8f9fa',
              100: '#f1f3f5',
              200: '#e9ecef',
              300: '#dee2e6',
              400: '#ced4da',
              500: '#adb5bd',
              600: '#868e96',
              700: '#495057',
              800: '#343a40',
              900: '#212529',
            }
          }
        }
      }
    }
  </script>
</head>
<body class="bg-gray-50">
  <div class="min-h-screen flex items-center justify-center px-4 py-12">
    <div class="max-w-md w-full space-y-8">
      <!-- Logo/Header -->
      <div class="text-center">
        <h1 class="text-3xl sm:text-4xl font-bold text-brand-900 mb-2">Lift-Log</h1>
        <p class="text-brand-600">Start tracking your strength journey</p>
      </div>

      <!-- Signup Form -->
      <div class="bg-white rounded-lg border border-gray-200 p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-brand-900 mb-6">Create Account</h2>
        
        <% if (typeof error !== 'undefined' && error) { %>
          <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
            <%= error %>
          </div>
        <% } %>
        
        <form action="/signup" method="POST" class="space-y-4">
          <div>
            <label for="username" class="block text-sm font-medium text-brand-700 mb-1">
              Username
            </label>
            <input
              type="text"
              id="username"
              name="username"
              required
              autofocus
              minlength="3"
              maxlength="30"
              pattern="[a-zA-Z0-9_-]+"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-brand-500"
              placeholder="Choose a username"
            >
            <p class="mt-1 text-xs text-brand-500">3-30 characters, letters, numbers, hyphens, underscores</p>
          </div>

          <div>
            <label for="email" class="block text-sm font-medium text-brand-700 mb-1">
              Email (optional)
            </label>
            <input
              type="email"
              id="email"
              name="email"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-brand-500"
              placeholder="your@email.com"
            >
            <p class="mt-1 text-xs text-brand-500">For account recovery (optional)</p>
          </div>

          <div>
            <label for="password" class="block text-sm font-medium text-brand-700 mb-1">
              Password
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              minlength="8"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-brand-500"
              placeholder="Create a password"
            >
            <p class="mt-1 text-xs text-brand-500">Minimum 8 characters</p>
          </div>

          <div>
            <label for="confirmPassword" class="block text-sm font-medium text-brand-700 mb-1">
              Confirm Password
            </label>
            <input
              type="password"
              id="confirmPassword"
              name="confirmPassword"
              required
              minlength="8"
              class="w-full border border-gray-300 rounded-lg px-3 py-2.5 text-brand-900 focus:outline-none focus:ring-2 focus:ring-brand-500"
              placeholder="Confirm your password"
            >
          </div>

          <button
            type="submit"
            class="w-full bg-brand-900 hover:bg-brand-800 text-white font-semibold py-3 rounded-lg transition"
          >
            Create Account
          </button>
        </form>

        <div class="mt-6 text-center">
          <p class="text-sm text-brand-600">
            Already have an account?
            <a href="/login" class="text-brand-900 font-medium hover:underline">Sign in</a>
          </p>
        </div>
      </div>

      <!-- Footer -->
      <p class="text-center text-xs text-brand-500">
        © 2026 Lift-Log. All rights reserved.
      </p>
    </div>
  </div>

  <script>
    // Client-side password validation
    document.querySelector('form').addEventListener('submit', function(e) {
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      
      if (password !== confirmPassword) {
        e.preventDefault();
        alert('Passwords do not match');
      }
    });
  </script>
</body>
</html>
