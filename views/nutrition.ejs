<%- include('partials/header') %>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>

<div class="space-y-4">

  <!-- Header + Date Nav -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
    <div class="flex items-center justify-between mb-3">
      <h1 class="text-2xl font-bold text-brand-900">Nutrition</h1>
      <a href="/nutrition?date=<%= new Date().toISOString().split('T')[0] %>"
        class="text-sm text-brand-600 hover:text-yellow-400 transition">Today</a>
    </div>
    <div class="flex items-center gap-2">
      <button onclick="changeDate(-1)" class="p-2 rounded-lg border border-gray-800 hover:bg-gray-800 transition">
        <svg class="w-4 h-4 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <span id="date-display" class="flex-1 text-center font-medium text-brand-900 text-sm"></span>
      <button onclick="changeDate(1)" class="p-2 rounded-lg border border-gray-800 hover:bg-gray-800 transition">
        <svg class="w-4 h-4 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Daily Totals vs Goals -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg font-bold text-brand-900">Daily Totals</h2>
      <button onclick="document.getElementById('goals-modal').classList.remove('hidden')"
        class="text-sm text-brand-600 hover:text-yellow-400 transition">Edit Goals</button>
    </div>

    <div class="flex flex-col sm:flex-row items-center gap-6">
      <!-- Calories ring -->
      <div class="relative flex-shrink-0" style="width: 160px; height: 160px;">
        <canvas id="calorie-ring"></canvas>
        <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
          <p class="text-2xl font-bold text-brand-900" id="calorie-ring-value"><%= Math.round(totals.calories) %></p>
          <p class="text-xs text-brand-500" id="calorie-ring-label">
            of <%= Math.round(goal.calories) %> kcal
          </p>
        </div>
      </div>

      <!-- Macro bars -->
      <div class="flex-1 w-full space-y-3">
        <% const macros = [
          { label: 'Protein', value: totals.protein, goal: goal.protein, unit: 'g', color: '#7c3aed' },
          { label: 'Carbs', value: totals.carbs, goal: goal.carbs, unit: 'g', color: '#3b82f6' },
          { label: 'Fat', value: totals.fat, goal: goal.fat, unit: 'g', color: '#16a34a' },
        ]; %>
        <% macros.forEach(function(m) {
          const pct = Math.min(Math.round((m.value / m.goal) * 100), 100);
          const over = m.value > m.goal;
        %>
        <div>
          <div class="flex justify-between text-sm mb-1">
            <span class="font-medium text-brand-700 flex items-center gap-1.5">
              <span class="inline-block w-2 h-2 rounded-full" style="background-color: <%= m.color %>"></span>
              <%= m.label %>
            </span>
            <span class="<%= over ? 'text-red-500 font-semibold' : 'text-brand-500' %>">
              <%= Math.round(m.value) %><span class="text-xs">/<%= Math.round(m.goal) %><%= m.unit %></span>
            </span>
          </div>
          <div class="h-2 bg-gray-800 rounded-full overflow-hidden">
            <div class="h-full rounded-full transition-all"
              style="width: <%= pct %>%; background-color: <%= over ? '#dc2626' : m.color %>"></div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- 30-Day Trends -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
    <h2 class="text-lg font-bold text-brand-900 mb-4">Last 30 Days</h2>
    <div id="trend-empty" class="hidden py-8 text-center text-brand-500 text-sm">
      Log food for a few days to see your trends here.
    </div>
    <div id="trend-charts" class="space-y-6">
      <div style="position: relative; height: 220px;">
        <canvas id="calorie-trend-chart"></canvas>
      </div>
      <div style="position: relative; height: 220px;">
        <canvas id="macro-trend-chart"></canvas>
      </div>
    </div>
  </div>

  <!-- Food Search + Log -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-4 sm:p-6">
    <div class="flex items-start justify-between mb-4">
      <h2 class="text-lg font-bold text-brand-900">Log Food</h2>
      <span class="text-xs text-brand-400 text-right max-w-xs leading-snug">
        * Food data is provided by the USDA database. Some entries may have inaccurate values — always cross-check if something looks off. As your subscription helps us grow, we'll upgrade to a verified nutrition database.
      </span>
    </div>

    <!-- Search -->
    <div class="relative mb-4">
      <input type="text" id="food-search" placeholder="Search foods (e.g. chicken breast, oats...)"
        autocomplete="off"
        class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2.5 text-brand-900 placeholder-gray-600 focus:outline-none focus:ring-2 focus:ring-yellow-500 pr-10">
      <div id="search-spinner" class="hidden absolute right-3 top-3">
        <svg class="animate-spin w-4 h-4 text-brand-500" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"></path>
        </svg>
      </div>
      <div id="food-results"
        class="hidden absolute z-20 w-full bg-gray-900 border border-gray-800 rounded-lg shadow-lg mt-1 max-h-64 overflow-y-auto">
      </div>
    </div>

    <!-- Selected food form (hidden until food picked) -->
    <div id="food-form" class="hidden space-y-3">
      <div class="bg-gray-800 border border-gray-700 text-white rounded-lg p-3">
        <p class="font-semibold text-brand-900" id="selected-food-name"></p>
        <p class="text-sm text-brand-600" id="selected-food-brand"></p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Number of Servings</label>
          <input type="number" id="serving-size" step="0.5" min="0.5" value="1"
            class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-500">
        </div>
        <div class="flex flex-col justify-end">
          <p class="text-sm text-brand-500 pb-2">1 serving = <span id="grams-per-serving">—</span></p>
        </div>
      </div>

      <!-- Macro preview -->
      <div class="grid grid-cols-4 gap-2 text-center">
        <% [['cal-preview','Calories','kcal'],['protein-preview','Protein','g'],['carbs-preview','Carbs','g'],['fat-preview','Fat','g']].forEach(function(m) { %>
        <div class="bg-black rounded-lg p-2">
          <p class="text-lg font-bold text-brand-900" id="<%= m[0] %>">0</p>
          <p class="text-xs text-brand-500"><%= m[1] %></p>
        </div>
        <% }); %>
      </div>

      <button onclick="logFood()"
        class="w-full bg-yellow-500 hover:bg-yellow-600 text-black font-semibold py-3 rounded-lg transition">
        Add to Log
      </button>
      <button onclick="clearFood()" class="w-full text-sm text-brand-500 hover:text-yellow-400 transition py-1">
        Cancel
      </button>
    </div>
  </div>

  <!-- Today's Log -->
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-4 sm:px-6 py-4 border-b border-gray-800">
      <h2 class="text-lg font-bold text-brand-900">Today's Log</h2>
    </div>
    <div id="nutrition-log-list">
      <% if (logs.length === 0) { %>
      <div class="px-6 py-8 text-center text-brand-500">
        <p class="text-sm">No food logged yet. Search above to get started.</p>
      </div>
      <% } else { %>
        <% logs.forEach(function(log) { %>
        <div class="px-4 sm:px-6 py-3 border-b border-gray-800 flex items-center justify-between" id="log-<%= log.id %>">
          <div>
            <p class="font-medium text-brand-900 text-sm"><%= log.foodName %></p>
            <p class="text-xs text-brand-500">
              <%= log.servingSize %> <%= log.servingUnit %> &nbsp;·&nbsp;
              <%= Math.round(log.calories) %> kcal &nbsp;·&nbsp;
              P: <%= Math.round(log.protein) %>g &nbsp;·&nbsp;
              C: <%= Math.round(log.carbs) %>g &nbsp;·&nbsp;
              F: <%= Math.round(log.fat) %>g
            </p>
          </div>
          <button
            hx-delete="/api/nutrition/<%= log.id %>"
            hx-target="#log-<%= log.id %>"
            hx-swap="outerHTML swap:0.3s"
            hx-confirm="Remove this entry?"
            class="text-brand-400 hover:text-red-500 transition ml-3">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
          </button>
        </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</div>

<!-- Goals Modal -->
<div id="goals-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4">
  <div class="bg-gray-900 rounded-lg p-6 w-full max-w-sm">
    <h3 class="text-xl font-bold text-brand-900 mb-4">Daily Macro Goals</h3>
    <div class="space-y-3">
      <% [['calories','Calories (kcal)', goal.calories],['protein','Protein (g)', goal.protein],['carbs','Carbs (g)', goal.carbs],['fat','Fat (g)', goal.fat]].forEach(function(f) { %>
      <div>
        <label class="block text-sm font-medium text-brand-700 mb-1"><%= f[1] %></label>
        <input type="number" id="goal-<%= f[0] %>" value="<%= Math.round(f[2]) %>" min="0"
          class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-yellow-500">
      </div>
      <% }); %>
    </div>
    <div class="flex gap-3 mt-5">
      <button onclick="saveGoals()"
        class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-black font-semibold py-2.5 rounded-lg transition">
        Save
      </button>
      <button onclick="document.getElementById('goals-modal').classList.add('hidden')"
        class="flex-1 bg-gray-800 hover:bg-gray-700 text-brand-900 font-medium py-2.5 rounded-lg transition">
        Cancel
      </button>
    </div>
  </div>
</div>

<script>
  const currentDate = '<%= date %>';
  let selectedFood = null;
  let searchTimer = null;

  // ── Date nav ──────────────────────────────────────────────────────────────
  function updateDateDisplay() {
    const d = new Date(currentDate + 'T00:00:00');
    document.getElementById('date-display').textContent = d.toLocaleDateString('en-US', {
      weekday: 'long', month: 'long', day: 'numeric', year: 'numeric'
    });
  }
  updateDateDisplay();

  function changeDate(days) {
    const d = new Date(currentDate + 'T00:00:00');
    d.setDate(d.getDate() + days);
    window.location.href = `/nutrition?date=${d.toISOString().split('T')[0]}`;
  }

  // ── Food search ──────────────────────────────────────────────────────────
  const foodSearch = document.getElementById('food-search');
  const foodResults = document.getElementById('food-results');
  const spinner = document.getElementById('search-spinner');

  foodSearch.addEventListener('input', () => {
    clearTimeout(searchTimer);
    const q = foodSearch.value.trim();
    if (q.length < 2) { foodResults.classList.add('hidden'); return; }
    searchTimer = setTimeout(() => searchFood(q), 500);
  });

  async function searchFood(q) {
    spinner.classList.remove('hidden');
    foodResults.classList.add('hidden');
    try {
      const res = await fetch(`/api/food/search?q=${encodeURIComponent(q)}`);
      const foods = await res.json();
      spinner.classList.add('hidden');
      if (!foods.length) {
        foodResults.innerHTML = '<div class="px-4 py-3 text-sm text-brand-500">No results found. Try a different search.</div>';
        foodResults.classList.remove('hidden');
        return;
      }
      foodResults.innerHTML = foods.map((f, i) => `
        <div class="food-result px-4 py-3 cursor-pointer hover:bg-gray-800 border-b border-gray-800 last:border-0"
          onclick="selectFood(${i})">
          <p class="text-sm font-medium text-brand-900">${f.name}</p>
          <p class="text-xs text-brand-500">${f.brand ? f.brand + ' · ' : ''}per serving (${f.gramsPerServing}${f.servingUnit || 'g'}) · ${f.calories}kcal · P:${f.protein}g C:${f.carbs}g F:${f.fat}g</p>
        </div>
      `).join('');
      // Store foods on window for selectFood
      window._foodResults = foods;
      foodResults.classList.remove('hidden');
    } catch(e) {
      spinner.classList.add('hidden');
    }
  }

  document.addEventListener('click', (e) => {
    if (!foodResults.contains(e.target) && e.target !== foodSearch) {
      foodResults.classList.add('hidden');
    }
  });

  function selectFood(i) {
    selectedFood = window._foodResults[i];
    foodResults.classList.add('hidden');
    foodSearch.value = selectedFood.name;
    document.getElementById('selected-food-name').textContent = selectedFood.name;
    document.getElementById('selected-food-brand').textContent = selectedFood.brand || '';
    document.getElementById('serving-size').value = 1;
    document.getElementById('grams-per-serving').textContent = selectedFood.gramsPerServing + (selectedFood.servingUnit || 'g');
    document.getElementById('food-form').classList.remove('hidden');
    updateMacroPreview();
  }

  function clearFood() {
    selectedFood = null;
    foodSearch.value = '';
    document.getElementById('food-form').classList.add('hidden');
  }

  // ── Portion recalculation ─────────────────────────────────────────────────
  document.getElementById('serving-size').addEventListener('input', updateMacroPreview);

  function updateMacroPreview() {
    if (!selectedFood) return;
    const servings = parseFloat(document.getElementById('serving-size').value) || 1;
    document.getElementById('cal-preview').textContent = Math.round(selectedFood.calories * servings);
    document.getElementById('protein-preview').textContent = (selectedFood.protein * servings).toFixed(1);
    document.getElementById('carbs-preview').textContent = (selectedFood.carbs * servings).toFixed(1);
    document.getElementById('fat-preview').textContent = (selectedFood.fat * servings).toFixed(1);
  }

  // ── Log food ──────────────────────────────────────────────────────────────
  async function logFood() {
    if (!selectedFood) return;
    const servings = parseFloat(document.getElementById('serving-size').value) || 1;
    const payload = {
      foodName: selectedFood.name,
      brandName: selectedFood.brand || null,
      servingSize: servings,
      servingUnit: "serving",
      calories: Math.round(selectedFood.calories * servings * 10) / 10,
      protein: Math.round(selectedFood.protein * servings * 10) / 10,
      carbs: Math.round(selectedFood.carbs * servings * 10) / 10,
      fat: Math.round(selectedFood.fat * servings * 10) / 10,
      date: currentDate,
    };
    const res = await fetch('/api/nutrition', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) {
      window.location.reload();
    }
  }

  // ── Goals ─────────────────────────────────────────────────────────────────
  async function saveGoals() {
    const payload = {
      calories: parseFloat(document.getElementById('goal-calories').value),
      protein: parseFloat(document.getElementById('goal-protein').value),
      carbs: parseFloat(document.getElementById('goal-carbs').value),
      fat: parseFloat(document.getElementById('goal-fat').value),
    };
    const res = await fetch('/api/nutrition/goals', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (res.ok) window.location.reload();
  }

  // ── Calorie ring ──────────────────────────────────────────────────────────
  (function renderCalorieRing() {
    const consumed = <%= totals.calories %>;
    const goalCalories = <%= goal.calories %>;
    const over = consumed > goalCalories;
    const consumedClamped = Math.min(consumed, goalCalories);
    const remaining = Math.max(goalCalories - consumed, 0);

    document.getElementById('calorie-ring-label').textContent = over
      ? `${Math.round(consumed - goalCalories)} kcal over ${Math.round(goalCalories)}`
      : `of ${Math.round(goalCalories)} kcal`;

    new Chart(document.getElementById('calorie-ring'), {
      type: 'doughnut',
      data: {
        datasets: [{
          data: over ? [goalCalories, 0] : [consumedClamped, remaining],
          backgroundColor: over ? ['#dc2626'] : ['#EAB308', '#374151'],
          borderWidth: 0,
        }],
      },
      options: {
        cutout: '75%',
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false }, tooltip: { enabled: false } },
      },
    });
  })();

  // ── 30-day trends ────────────────────────────────────────────────────────
  (async function renderTrends() {
    const res = await fetch('/api/nutrition/history?days=30');
    const history = await res.json();
    const hasData = history.some(d => d.calories > 0);

    if (!hasData) {
      document.getElementById('trend-empty').classList.remove('hidden');
      document.getElementById('trend-charts').classList.add('hidden');
      return;
    }

    const labels = history.map(d => {
      const parts = d.date.split('-');
      return `${parseInt(parts[1])}/${parseInt(parts[2])}`;
    });
    const goalCalories = <%= goal.calories %>;

    new Chart(document.getElementById('calorie-trend-chart'), {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'Calories',
            data: history.map(d => Math.round(d.calories)),
            borderColor: '#EAB308',
            backgroundColor: 'rgba(234, 179, 8, 0.12)',
            fill: true,
            tension: 0.3,
            pointRadius: 2,
          },
          {
            label: 'Goal',
            data: history.map(() => goalCalories),
            borderColor: '#6b7280',
            borderDash: [4, 4],
            pointRadius: 0,
            fill: false,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 }, color: '#d1d5db' } },
          title: { display: true, text: 'Calories', align: 'start', font: { size: 13 }, color: '#d1d5db' },
        },
        scales: {
          x: { ticks: { maxTicksLimit: 8, color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.06)' } },
          y: { ticks: { color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.06)' } },
        },
      },
    });

    new Chart(document.getElementById('macro-trend-chart'), {
      type: 'line',
      data: {
        labels,
        datasets: [
          { label: 'Protein (g)', data: history.map(d => Math.round(d.protein)), borderColor: '#7c3aed', backgroundColor: 'transparent', pointRadius: 2, tension: 0.3 },
          { label: 'Carbs (g)', data: history.map(d => Math.round(d.carbs)), borderColor: '#3b82f6', backgroundColor: 'transparent', pointRadius: 2, tension: 0.3 },
          { label: 'Fat (g)', data: history.map(d => Math.round(d.fat)), borderColor: '#16a34a', backgroundColor: 'transparent', pointRadius: 2, tension: 0.3 },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { position: 'top', labels: { boxWidth: 12, font: { size: 11 }, color: '#d1d5db' } },
          title: { display: true, text: 'Macros', align: 'start', font: { size: 13 }, color: '#d1d5db' },
        },
        scales: {
          x: { ticks: { maxTicksLimit: 8, color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.06)' } },
          y: { ticks: { color: '#9ca3af' }, grid: { color: 'rgba(255,255,255,0.06)' } },
        },
      },
    });
  })();
</script>

<%- include('partials/footer') %>
