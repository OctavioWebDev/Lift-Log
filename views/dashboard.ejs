<%- include('partials/header') %>

<div class="space-y-8">
  <!-- Hero Section - Simple & Bold -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-8">
    <h1 class="text-4xl font-bold text-brand-900 mb-2">Dashboard</h1>
    <p class="text-lg text-brand-600">Track your progress. Build real strength.</p>
  </div>

  <!-- Stats Cards - Clean & Minimal -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Workouts This Week -->
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
      <p class="text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">This Week</p>
      <p class="text-4xl font-bold text-brand-900 mb-1"><%= stats.workoutsThisWeek %></p>
      <p class="text-sm text-brand-600">Workouts</p>
    </div>

    <!-- Total Volume -->
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
      <p class="text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">Total Volume</p>
      <p class="text-4xl font-bold text-brand-900 mb-1"><%= stats.totalVolume.toLocaleString() %></p>
      <p class="text-sm text-brand-600">lbs this week</p>
    </div>

    <!-- Active Goals -->
    <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
      <p class="text-sm font-medium text-brand-600 uppercase tracking-wide mb-1">Active Goals</p>
      <p class="text-4xl font-bold text-brand-900 mb-1"><%= stats.activeGoals %></p>
      <p class="text-sm text-brand-600">In progress</p>
    </div>
  </div>

  <!-- Workout Consistency Heatmap -->
  <div class="bg-gray-900 rounded-lg border border-gray-800 p-6">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-brand-900">Consistency</h2>
      <a href="/progress" class="text-sm font-medium text-brand-700 hover:text-yellow-400 transition">
        View Progress →
      </a>
    </div>
    <div id="heatmap" class="overflow-x-auto pb-1"></div>
  </div>

  <!-- Quick Actions - Simple Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Log Workout -->
    <a href="/app" class="group bg-gray-900 rounded-lg border border-gray-800 p-6 hover:border-gray-600 transition">
      <div class="flex items-start justify-between">
        <div>
          <h3 class="text-xl font-bold text-brand-900 mb-2 group-hover:text-yellow-400 transition">Log Workout</h3>
          <p class="text-brand-600">Record your sets and track your progress</p>
        </div>
        <svg class="w-6 h-6 text-brand-400 group-hover:text-yellow-400 transition flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- View Goals -->
    <a href="/goals" class="group bg-gray-900 rounded-lg border border-gray-800 p-6 hover:border-gray-600 transition">
      <div class="flex items-start justify-between">
        <div>
          <h3 class="text-xl font-bold text-brand-900 mb-2 group-hover:text-yellow-400 transition">View Goals</h3>
          <p class="text-brand-600">Track and manage your training goals</p>
        </div>
        <svg class="w-6 h-6 text-brand-400 group-hover:text-yellow-400 transition flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>

    <!-- Badges -->
    <a href="/badges" class="group bg-gray-900 rounded-lg border border-gray-800 p-6 hover:border-gray-600 transition">
      <div class="flex items-start justify-between">
        <div>
          <h3 class="text-xl font-bold text-brand-900 mb-2 group-hover:text-yellow-400 transition">Badges</h3>
          <p class="text-brand-600"><%= stats.badgeCount %> of <%= stats.totalBadgeCount %> earned</p>
        </div>
        <svg class="w-6 h-6 text-brand-400 group-hover:text-yellow-400 transition flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </div>
    </a>
  </div>

  <!-- Recent Workouts - With Edit/Delete -->
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-6 py-4 border-b border-gray-800">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-brand-900">Recent Workouts</h2>
        <a href="/app" class="text-sm font-medium text-brand-700 hover:text-yellow-400 transition">
          View All →
        </a>
      </div>
    </div>
    
    <div class="divide-y divide-gray-800" id="recent-workouts-list">
      <% if (recentWorkouts.length === 0) { %>
        <div class="px-6 py-12 text-center">
          <p class="text-brand-600">No workouts logged yet. Start tracking today.</p>
        </div>
      <% } else { %>
        <% recentWorkouts.slice(0, 5).forEach(function(workout) { %>
          <div class="px-6 py-4 hover:bg-gray-800 transition" id="workout-<%= workout.id %>">
            <div class="flex items-center justify-between">
              <div class="flex-1">
                <h3 class="font-bold text-brand-900 mb-1"><%= workout.exercise %></h3>
                <p class="text-sm text-brand-600">
                  <%= workout.sets %> sets × <%= workout.weight %> lbs × <%= workout.reps %> reps
                  <% if (workout.rpe) { %>
                    <span class="text-brand-500">• RPE <%= workout.rpe %></span>
                  <% } %>
                </p>
              </div>
              
              <div class="flex items-center space-x-2">
                <span class="text-sm font-medium text-brand-600 mr-2">
                  <%= new Date(workout.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                </span>
                
                <!-- Edit Button -->
                <button
                  onclick="editWorkout(<%= workout.id %>, '<%= workout.exercise %>', <%= JSON.stringify(new Date(workout.date).toISOString().split('T')[0]) %>, <%= workout.sets %>, <%= workout.weight %>, <%= workout.reps %>, <%= workout.rpe || 'null' %>)"
                  class="text-brand-600 hover:text-yellow-400 transition p-1"
                  title="Edit"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                  </svg>
                </button>
                
                <!-- Delete Button -->
                <button
                  hx-delete="/api/workout-sets/<%= workout.id %>"
                  hx-target="#workout-<%= workout.id %>"
                  hx-swap="outerHTML"
                  hx-confirm="Delete this workout?"
                  class="text-brand-500 hover:text-red-500 transition p-1"
                  title="Delete"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                </button>
              </div>
            </div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>

  <!-- Goal Progress - With Edit/Delete -->
  <% if (goals.length > 0) { %>
  <div class="bg-gray-900 rounded-lg border border-gray-800">
    <div class="px-6 py-4 border-b border-gray-800">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold text-brand-900">Goal Progress</h2>
        <a href="/goals" class="text-sm font-medium text-brand-700 hover:text-yellow-400 transition">
          View All →
        </a>
      </div>
    </div>
    
    <div class="divide-y divide-gray-800" id="goals-preview-list">
      <% goals.slice(0, 3).forEach(function(goal) { %>
        <% 
          const progress = Math.min((goal.current / goal.target) * 100, 100);
          const remaining = goal.target - goal.current;
        %>
        <div class="p-6" id="goal-preview-<%= goal.id %>">
          <div class="flex justify-between items-start mb-3">
            <h3 class="font-bold text-brand-900"><%= goal.exercise %></h3>
            
            <div class="flex items-center space-x-2">
              <span class="text-sm font-medium text-brand-600"><%= progress.toFixed(0) %>%</span>
              
              <!-- Edit Button -->
              <button
                onclick="editGoal(<%= goal.id %>, '<%= goal.exercise %>', <%= goal.current %>, <%= goal.target %>)"
                class="text-brand-600 hover:text-yellow-400 transition p-1"
                title="Edit"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              </button>
              
              <!-- Delete Button -->
              <button
                hx-delete="/api/goals/<%= goal.id %>"
                hx-target="#goal-preview-<%= goal.id %>"
                hx-swap="outerHTML"
                hx-confirm="Delete this goal?"
                class="text-brand-500 hover:text-red-500 transition p-1"
                title="Delete"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              </button>
            </div>
          </div>
          
          <!-- Progress Bar -->
          <div class="w-full bg-gray-800 rounded-full h-2 mb-2">
            <div 
              class="bg-yellow-500 h-2 rounded-full transition-all duration-500"
              style="width: <%= progress %>%"
            ></div>
          </div>
          
          <div class="flex justify-between text-sm text-brand-600">
            <span><%= goal.current %> <%= goal.unit %></span>
            <span><%= goal.target %> <%= goal.unit %></span>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>

<!-- Edit Workout Modal -->
<div id="edit-workout-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-gray-900 rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-xl font-bold text-brand-900 mb-4">Edit Workout</h3>
    
    <form id="edit-workout-form" class="space-y-4">
      <input type="hidden" id="edit-workout-id">
      
      <div>
        <label class="block text-sm font-medium text-brand-700 mb-1">Exercise</label>
        <input type="text" id="edit-exercise" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
      </div>

      <div>
        <label class="block text-sm font-medium text-brand-700 mb-1">Date</label>
        <input type="date" id="edit-date" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Sets</label>
          <input type="number" id="edit-sets" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Reps</label>
          <input type="number" id="edit-reps" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Weight (lbs)</label>
          <input type="number" id="edit-weight" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
        <div>
          <label class="flex items-center gap-1 text-sm font-medium text-brand-700 mb-1">
            RPE
            <button type="button" onclick="showInfoTooltip(event, 'RPE (Rate of Perceived Exertion) rates how hard a set felt, from 1 (very easy) to 10 (max effort — you could not do another rep).')" class="text-brand-500 hover:text-yellow-500" aria-label="What is RPE?">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" stroke-width="2" />
                <path stroke-linecap="round" stroke-width="2" d="M12 16v-4m0-4h.01" />
              </svg>
            </button>
          </label>
          <input type="number" step="0.5" min="1" max="10" id="edit-rpe" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2">
        </div>
      </div>
      
      <div class="flex space-x-3">
        <button type="submit" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-black py-2 rounded-lg transition">
          Save Changes
        </button>
        <button type="button" onclick="closeEditWorkoutModal()" class="flex-1 bg-gray-800 hover:bg-gray-700 text-brand-900 py-2 rounded-lg transition">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Goal Modal -->
<div id="edit-goal-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
  <div class="bg-gray-900 rounded-lg p-6 max-w-md w-full mx-4">
    <h3 class="text-xl font-bold text-brand-900 mb-4">Edit Goal</h3>
    
    <form id="edit-goal-form" class="space-y-4">
      <input type="hidden" id="edit-goal-id">
      
      <div>
        <label class="block text-sm font-medium text-brand-700 mb-1">Exercise</label>
        <input type="text" id="edit-goal-exercise" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
      </div>
      
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Current (lbs)</label>
          <input type="number" id="edit-goal-current" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
        <div>
          <label class="block text-sm font-medium text-brand-700 mb-1">Target (lbs)</label>
          <input type="number" id="edit-goal-target" class="w-full bg-gray-800 border border-gray-700 text-white rounded-lg px-3 py-2" required>
        </div>
      </div>
      
      <div class="flex space-x-3">
        <button type="submit" class="flex-1 bg-yellow-500 hover:bg-yellow-600 text-black py-2 rounded-lg transition">
          Save Changes
        </button>
        <button type="button" onclick="closeEditGoalModal()" class="flex-1 bg-gray-800 hover:bg-gray-700 text-brand-900 py-2 rounded-lg transition">
          Cancel
        </button>
      </div>
    </form>
  </div>
</div>

<script>
// ── Consistency heatmap ──────────────────────────────────────────────────────
(function renderHeatmap() {
  const workoutDates = new Set(<%- JSON.stringify(workoutDates) %>);
  const heatmapDays = <%= heatmapDays %>;
  const container = document.getElementById('heatmap');

  const today = new Date();
  today.setHours(0, 0, 0, 0);
  const start = new Date(today);
  start.setDate(start.getDate() - (heatmapDays - 1));
  start.setDate(start.getDate() - start.getDay()); // align to Sunday

  const weeks = [];
  const cursor = new Date(start);
  while (cursor <= today) {
    const week = [];
    for (let d = 0; d < 7; d++) {
      week.push(new Date(cursor));
      cursor.setDate(cursor.getDate() + 1);
    }
    weeks.push(week);
  }

  const grid = document.createElement('div');
  grid.className = 'flex gap-1 w-max';
  weeks.forEach(week => {
    const col = document.createElement('div');
    col.className = 'flex flex-col gap-1';
    week.forEach(day => {
      const key = day.toISOString().split('T')[0];
      const isFuture = day > today;
      const hasWorkout = workoutDates.has(key);
      const cell = document.createElement('div');
      cell.className = 'w-3 h-3 rounded-sm ' +
        (isFuture ? 'bg-transparent' : hasWorkout ? 'bg-yellow-500' : 'bg-gray-800');
      cell.title = key + (hasWorkout ? ' — workout logged' : '');
      col.appendChild(cell);
    });
    grid.appendChild(col);
  });
  container.appendChild(grid);
})();

// Edit Workout Functions
function editWorkout(id, exercise, date, sets, weight, reps, rpe) {
  document.getElementById('edit-workout-id').value = id;
  document.getElementById('edit-exercise').value = exercise;
  document.getElementById('edit-date').value = date;
  document.getElementById('edit-sets').value = sets;
  document.getElementById('edit-weight').value = weight;
  document.getElementById('edit-reps').value = reps;
  document.getElementById('edit-rpe').value = rpe || '';
  document.getElementById('edit-workout-modal').classList.remove('hidden');
}

function closeEditWorkoutModal() {
  document.getElementById('edit-workout-modal').classList.add('hidden');
}

document.getElementById('edit-workout-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const id = document.getElementById('edit-workout-id').value;
  const data = {
    exercise: document.getElementById('edit-exercise').value,
    date: document.getElementById('edit-date').value,
    sets: parseInt(document.getElementById('edit-sets').value),
    weight: parseFloat(document.getElementById('edit-weight').value),
    reps: parseInt(document.getElementById('edit-reps').value),
    rpe: document.getElementById('edit-rpe').value ? parseFloat(document.getElementById('edit-rpe').value) : null
  };
  
  try {
    const response = await fetch(`/api/workout-sets/${id}`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    if (response.ok) {
      closeEditWorkoutModal();
      window.location.reload(); // Reload to show updated data
    } else {
      alert('Error updating workout');
    }
  } catch (error) {
    alert('Error updating workout');
  }
});

// Edit Goal Functions
function editGoal(id, exercise, current, target) {
  document.getElementById('edit-goal-id').value = id;
  document.getElementById('edit-goal-exercise').value = exercise;
  document.getElementById('edit-goal-current').value = current;
  document.getElementById('edit-goal-target').value = target;
  document.getElementById('edit-goal-modal').classList.remove('hidden');
}

function closeEditGoalModal() {
  document.getElementById('edit-goal-modal').classList.add('hidden');
}

document.getElementById('edit-goal-form').addEventListener('submit', async (e) => {
  e.preventDefault();
  const exercise = document.getElementById('edit-goal-exercise').value;
  const data = {
    current: parseFloat(document.getElementById('edit-goal-current').value),
    target: parseFloat(document.getElementById('edit-goal-target').value)
  };
  
  try {
    const response = await fetch(`/api/goals/${encodeURIComponent(exercise)}`, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    });
    
    if (response.ok) {
      closeEditGoalModal();
      window.location.reload(); // Reload to show updated data
    } else {
      alert('Error updating goal');
    }
  } catch (error) {
    alert('Error updating goal');
  }
});

// Close modals when clicking outside
document.getElementById('edit-workout-modal').addEventListener('click', function(e) {
  if (e.target === this) closeEditWorkoutModal();
});

document.getElementById('edit-goal-modal').addEventListener('click', function(e) {
  if (e.target === this) closeEditGoalModal();
});
</script>

<%- include('partials/footer') %>
