# Server
PORT=3000
NODE_ENV=development

# Database (defaults to file:./data/sqlite.db if unset)
DATABASE_URL=file:./data/sqlite.db

# Web session auth (cookie-based, used by the EJS/HTMX app)
SESSION_SECRET=change-me

# Mobile JWT auth (used by the /api/v1 JSON API)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# Stripe billing (web app, and the mobile app's Android checkout flow)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_ANNUAL_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...

# RevenueCat webhook (mobile app's iOS in-app-purchase flow). Set this to any
# random string and configure the same value as the Authorization header in
# the RevenueCat dashboard under Project Settings > Webhooks.
REVENUECAT_WEBHOOK_SECRET=change-me

# USDA FoodData Central (nutrition food search)
USDA_API_KEY=
